{
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "crons": [
    { "path": "/api/notify/dispatch", "schedule": "0 3 * * *" },
    { "path": "/api/mail/sync", "schedule": "30 2 * * *" },
    { "path": "/api/mail/actions?op=process-scheduled", "schedule": "0 4 * * *" }
  ]
}
